{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "SPMU: Prepare Docker environment",
            "type": "shell",
            "command": "powershell",
            "args": ["-ExecutionPolicy", "Bypass", "-File", ".\\tools\\prepare-docker-local.ps1"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": []
        },
        {
            "label": "SPMU: Start Docker + MariaDB",
            "type": "shell",
            "command": "docker",
            "args": ["compose", "up", "-d", "--build"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": []
        },
        {
            "label": "SPMU: Apply migrations + seed",
            "type": "shell",
            "command": "docker",
            "args": ["compose", "exec", "-T", "app", "php", "artisan", "migrate", "--force", "&&", "docker", "compose", "exec", "-T", "app", "php", "artisan", "db:seed", "--force"],
            "options": {"cwd": "${workspaceFolder}", "shell": {"executable": "powershell.exe", "args": ["-NoProfile", "-Command"]}},
            "problemMatcher": []
        },
        {
            "label": "SPMU: Open Docker site",
            "type": "shell",
            "command": "Start-Process 'http://127.0.0.1:8080'",
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": []
        },
        {
            "label": "SPMU: Run Docker PHPUnit",
            "type": "shell",
            "command": "docker compose -p spmu-acpmp-test -f .\\docker-compose.test.yml build --no-cache test; if ($LASTEXITCODE -eq 0) { docker compose -p spmu-acpmp-test -f .\\docker-compose.test.yml run --rm test php vendor/bin/phpunit --testdox }",
            "options": {"cwd": "${workspaceFolder}", "shell": {"executable": "powershell.exe", "args": ["-NoProfile", "-Command"]}},
            "problemMatcher": []
        },
        {
            "label": "SPMU: Stop Docker",
            "type": "shell",
            "command": "docker",
            "args": ["compose", "down"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": []
        }
    ]
}
